# ============================================================
# .gitignore — Trading Bot B3
# ============================================================

# --- Credenciais e segredos (NUNCA commitar) ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
.pytest_tmp/
node_modules/

# --- Banco de dados e dados gerados (apenas raiz do projeto) ---
/data/
*.db
*.sqlite
*.sqlite3

# --- Logs e Artefatos Temporarios ---
logs/
.agents/*
!.agents/rules/
!.agents/skills/
!.agents/hooks.json
!.agents/scripts/
!.agents/AGENTS.md
# Registro institucional de agentes: apenas o registro canonico e versionado.
!.agents/registry/
.agents/registry/*
!.agents/registry/argus.md
frontend/.agents/
.todo.json
todo.md
terminal_logs/
*.log
*.jsonl

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/

# --- Backtest outputs locais ---
results/
reports/
.terraform/
*.pem
.terraform.lock.hcl
*.bak
patch_*.py
test_libs*.py
*.patch

# Config local do Claude Code (launch.json de preview) — nao e do projeto
.claude/
