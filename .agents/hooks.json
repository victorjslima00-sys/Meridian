{
  "nexus-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_tool_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
